{
  "name": "co2etrack-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.3",
  "description": "High-fidelity CCUS Traceability Platform for C44DEV SA",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web --",
    "build": "turbo run build && node scripts/build-dist.mjs",
    "build:dev": "turbo run build && node scripts/build-dist.mjs",
    "lint": "turbo run lint",
    "web:dev": "npm run dev --workspace=web",
    "api:dev": "cd apps/api && .venv/Scripts/python -m uvicorn main:app --reload",
    "marketing:dev": "npm run dev --workspace=marketing",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
